rules_version = '2';

// Pacts by PhonePact. Anyone who writes is signed in (with an invisible guest account at
// first, made the first time they sign), so every write carries a uid. Someone already in a
// pact can add another name to the end of the list. Before a pact's start date, its terms can
// be changed by someone signing the changed version in the same step: that makes a new version
// (ver), and a signature only counts for the version it was made on, so the others sign their
// own spot again. Each person can set their own end of the pact (an easier or harder version of
// the rule, just for them) when they sign, and change it by signing again until the start date.
// Each person can only fill an empty spot as themselves (one spot per account), record breaks
// for their own spot, and set their own end-of-pact choice. Anyone holding the 10-character link can read the pact, with or without an
// account, so a link opens without waiting for a sign-in; nobody can list the pacts.
// Whoever made a pact can delete it, with everything in it, for everyone.
// At most 10 people, the same limit as MAX_PEOPLE in pacts/index.html.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function pactPath(id) { return /databases/$(database)/documents/pacts/$(id); }
    function slotPath(id, s) { return /databases/$(database)/documents/pacts/$(id)/slots/$(s); }
    // getAfter so a slot written in the same batch as its pact can see the pact.
    function pactAfter(id) { return getAfter(pactPath(id)).data; }
    function memberPath(id) { return /databases/$(database)/documents/pacts/$(id)/members/$(request.auth.uid); }
    function ownsSlot(id, s) { return exists(slotPath(id, s)) && get(slotPath(id, s)).data.uid == request.auth.uid; }
    // The pact itself is deleted in the last batch, so it still exists while everything under it goes.
    function madeIt(id) { return get(pactPath(id)).data.by == request.auth.uid; }
    // Someone already in the pact brings someone new in: one more name at the end, nothing else changes.
    function addsName(id) {
      let d = request.resource.data;
      let o = resource.data;
      return exists(memberPath(id))
        && d.diff(o).affectedKeys().hasOnly(['names'])
        && d.names is list
        && d.names.size() == o.names.size() + 1
        && d.names.size() <= 10
        && d.names[0:o.names.size()] == o.names
        && text(d.names[o.names.size()], 30);
    }
    // A signature: your name, your drawing, the time, and your own end of the pact if you set one,
    // made on the pact as it stands (after this step, if this step changes it).
    function signsSpot(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'at', 'sig', 'ver', 'end'])
        && d.uid == request.auth.uid
        && d.get('ver', 0) == pactAfter(id).get('ver', 0)
        && text(d.name, 30)
        && d.sig is string && d.sig.size() <= 2000
        && (!('end' in d) || text(d.end, 140))
        && d.at == request.time;
    }
    // Changing the terms before the start date: the next version, with a true record of the last
    // one, and whoever changes it signs the new version (their spot, by their membership) in the same step.
    function changesTerms(id) {
      let d = request.resource.data;
      let o = resource.data;
      let spot = slotPath(id, string(getAfter(memberPath(id)).data.slot));
      return o.s > request.time.toMillis()
        && d.diff(o).affectedKeys().hasOnly(['t', 'r', 'n', 's', 'c', 'ver', 'ch', 'was'])
        && d.ver == o.get('ver', 0) + 1
        && text(d.t, 40) && text(d.r, 140) && text(d.c, 80) && text(d.ch, 30)
        && d.n is int && d.n >= 1 && d.n <= 90
        && d.s is int && d.s > request.time.toMillis() - 86400000
        && d.was == { 't': o.t, 'r': o.r, 'n': o.n, 's': o.s, 'c': o.c }
        && getAfter(spot).data.uid == request.auth.uid
        && getAfter(spot).data.get('ver', 0) == d.ver;
    }

    match /pacts/{id} {
      // The link is the key: holding it is enough to read the pact and everything on it.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && id.matches('^[a-z0-9]{10}$')
        && request.resource.data.keys().hasOnly(['v', 't', 'r', 'n', 's', 'c', 'a', 'l', 'names', 'by', 'at'])
        && request.resource.data.v == 2
        && text(request.resource.data.t, 40)
        && text(request.resource.data.r, 140)
        && text(request.resource.data.c, 80)
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 90
        && request.resource.data.s is int
        && request.resource.data.a in ['phone', 'bars', 'sun', 'link', 'glass', 'wifi', 'doc', 'vape', 'leaf', 'reel', 'bed', 'plate', 'dumbbell']
        && request.resource.data.l in ['ink', 'paper', 'stone', 'accent']
        && request.resource.data.names is list
        && request.resource.data.names.size() >= 2 && request.resource.data.names.size() <= 10
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if signedIn() && (addsName(id) || changesTerms(id));
      allow delete: if signedIn() && resource.data.by == request.auth.uid;

      // One document per person: '0' is the creator, '1' to '9' everyone else, in the order they were named.
      match /slots/{slot} {
        allow read: if true;
        allow create: if signedIn()
          && slot.matches('^[0-9]$')
          && int(slot) < pactAfter(id).names.size()
          && (slot != '0' || pactAfter(id).by == request.auth.uid)
          // One spot per account: the membership record is written with the spot and can't exist already.
          && !exists(memberPath(id))
          && getAfter(memberPath(id)).data.slot == int(slot)
          && signsSpot(id);
        // Signing your own spot again: after the pact changed (your signature was on an older
        // version), or before its start date, to change your end.
        allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && (resource.data.get('ver', 0) < pactAfter(id).get('ver', 0) || pactAfter(id).s > request.time.toMillis())
          && signsSpot(id);
        allow delete: if signedIn() && madeIt(id);
      }

      // Which spot each account holds, written in the same batch as the spot itself.
      match /members/{uid} {
        allow read: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['slot'])
          && request.resource.data.slot is int
          && getAfter(slotPath(id, string(request.resource.data.slot))).data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn() && madeIt(id);
      }

      // Id is "<slot>_<day>", so the same day can only be recorded once.
      match /breaks/{key} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['slot', 'day', 'at'])
          && request.resource.data.slot is int && request.resource.data.day is int
          && key == string(request.resource.data.slot) + '_' + string(request.resource.data.day)
          && request.resource.data.day >= 1 && request.resource.data.day <= get(pactPath(id)).data.n
          && ownsSlot(id, string(request.resource.data.slot))
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if signedIn() && madeIt(id);
      }

      // "Go again" or "I'm done", one per person, changeable.
      match /ends/{slot} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['choice', 'at'])
          && request.resource.data.choice in ['again', 'done']
          && ownsSlot(id, slot)
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && madeIt(id);
      }
    }

    // Each person's own list of pacts, for "Your pacts" on any device.
    match /users/{uid}/pacts/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
